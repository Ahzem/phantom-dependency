# Phantom Dependency Backend Environment
PHANTOM_HOST=127.0.0.1
PHANTOM_PORT=8000
PHANTOM_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Ollama local inference settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT_SECONDS=60

# Optional network enrichment
ENABLE_NETWORK_ENRICHMENT=false
NPM_REGISTRY_URL=https://registry.npmjs.org
OSV_API_URL=https://api.osv.dev/v1/query
REQUEST_TIMEOUT_SECONDS=10

# Data persistence directory (reports)
DATA_DIR=.data
